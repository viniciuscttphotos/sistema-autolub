# Copie estas variáveis para a configuração segura da Vercel quando a implantação for autorizada.
# Não coloque valores reais ou segredos neste arquivo.
AUTOLUB_PASSWORD=defina-na-vercel
AUTOLUB_SESSION_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
AUTOLUB_GAS_URL=https://script.google.com/macros/s/ID_DA_IMPLANTACAO/exec
